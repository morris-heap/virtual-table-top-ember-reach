# Copy to `.env` in the repo root (git-ignored) and fill in real values.
# Never commit, print or log the real file. See api/README.md.

# --- API / database (read by api/scripts/*.mjs) ---

# Optilogic Postgres connection: the Optilogic JSON on one line, or a postgresql:// URL.
#   {"host":"...","port":"5432","dbname":"...","user":"...","password":"...","sslmode":"require"}
#   postgresql://user:password@host:5432/dbname?sslmode=require
# (The legacy name Connection_String is still accepted.)
OPTILOGIC_CONNECTION_STRING=

# Optilogic app key: updates the database firewall (db:check, db:allow-cloudflare)
# and is uploaded as the Worker secret by `npm run secrets`.
OPTILOGIC_APP_KEY=

# --- Jira (optional; local tooling only, not used by the app or API) ---
# Jira_URL=https://morris-heap.atlassian.net
# Jira_Email=
# Jira_Token=
