{
  "$comment": "Map data used by the app and API (VTTER-74). Source of truth: docs/map-model/ (properties.md, data-model.md, inventory.md) and ADR 0011. Movement costs come from data/core.json `movement` (core rules §6.3). A new type or property is a change here, not a schema change.",
  "schemaVersion": 1,
  "kinds": ["space", "enclosure", "route", "portal", "static", "entity"],
  "kindLabels": {
    "space": "Environment space",
    "enclosure": "Enclosure",
    "route": "Route",
    "portal": "Portal",
    "static": "Static Object",
    "entity": "Entity"
  },
  "sizes": [
    { "id": "small", "label": "Small", "max": 30 },
    { "id": "medium", "label": "Medium", "max": 50 },
    { "id": "large", "label": "Large", "max": 100, "paidLater": true }
  ],
  "allowedSizes": ["small", "medium", "large"],
  "minSide": 5,
  "limits": {
    "mapsPerUser": 3,
    "objects": 500,
    "propsPerObject": 16,
    "onDepth": 8,
    "linksPerObject": 16,
    "nameMax": 80,
    "noteMax": 1000,
    "textMax": 80,
    "runNumbersMax": 2000,
    "itemBytesMax": 350000
  },
  "triggers": ["enter", "leave", "start-of-turn", "touch"],
  "frequencies": ["each", "once", "once-per-entity", "once-per-round"],
  "properties": [
    { "name": "difficult", "label": "Difficult", "group": "movement", "value": { "type": "flag" }, "acts": "now", "stack": "max",
      "help": "Entering costs 2 zones of Speed, never more (core §6.3)." },
    { "name": "impassable", "label": "Impassable", "group": "movement", "value": { "type": "flag" }, "acts": "now", "stack": "max",
      "help": "You can't enter the hex (core §6.3)." },
    { "name": "blocks", "label": "Blocks", "group": "movement", "value": { "type": "enum", "options": ["move", "sight", "move+sight"] }, "acts": "now", "stack": "max",
      "help": "On an edge Route or a Portal: you can't cross that edge. Blocking sight acts later, with fog of war." },
    { "name": "deep-water", "label": "Deep water", "group": "movement", "value": { "type": "number", "min": 1, "max": 30 }, "acts": "later", "stack": "top",
      "help": "Difficult, and an Athletics Test vs this DC to enter. Needs a rule before it acts." },
    { "name": "patrol", "label": "Patrol", "group": "movement", "value": { "type": "enum", "options": ["loop", "there-and-back"] }, "acts": "later", "stack": "none",
      "help": "Foes assigned to this Route follow it in the Foes' Phase." },
    { "name": "hazard", "label": "Hazard", "group": "danger", "acts": "later", "stack": "each",
      "value": { "type": "object", "fields": {
        "damage": { "type": "text", "max": 20 },
        "dodge": { "type": "number", "min": 1, "max": 30 },
        "on": { "type": "enum", "options": ["enter", "leave", "start-of-turn", "touch"] },
        "every": { "type": "enum", "options": ["each", "once", "once-per-entity", "once-per-round"] }
      } },
      "help": "The player rolls a dodge vs the DC (core §6.5): success avoids it, success at a cost takes half." },
    { "name": "burning", "label": "Burning", "group": "danger", "value": { "type": "flag" }, "acts": "later", "stack": "max",
      "help": "You gain the Burning condition (core §6.9)." },
    { "name": "hidden", "label": "Hidden", "group": "danger", "value": { "type": "number", "min": 1, "max": 30 }, "acts": "later", "stack": "top",
      "help": "GM-only until spotted with a Notice Test vs this DC, or until it fires." },
    { "name": "blocks-sight", "label": "Blocks sight", "group": "sight", "value": { "type": "flag" }, "acts": "later", "stack": "max",
      "help": "Sight stops here. Acts with fog of war." },
    { "name": "obscured", "label": "Obscured", "group": "sight", "value": { "type": "flag" }, "acts": "later", "stack": "max",
      "help": "Bane on ranged attacks and sight-based Notice Tests. Needs a rule before it acts." },
    { "name": "cover", "label": "Cover", "group": "sight", "value": { "type": "flag" }, "acts": "later", "stack": "max",
      "help": "You can Hide here (core §6.2)." },
    { "name": "weather", "label": "Weather", "group": "weather", "acts": "later", "stack": "each",
      "value": { "type": "object", "fields": { "name": { "type": "text", "max": 40 } }, "grants": ["difficult", "obscured", "burning", "blocks-sight"] },
      "help": "Grants the ticked properties to everything below it. Its Difficult counts toward movement now." },
    { "name": "shelter", "label": "Shelter", "group": "weather", "value": { "type": "enum", "options": ["weather"] }, "acts": "later", "stack": "none",
      "help": "Stops weather from the layers above reaching inside." },
    { "name": "use", "label": "Use", "group": "use", "acts": "later", "stack": "each",
      "value": { "type": "object", "fields": {
        "test": { "type": "text", "max": 40 },
        "dc": { "type": "number", "min": 1, "max": 30 },
        "effect": { "type": "text", "max": 200 }
      } },
      "help": "Your Action: the app offers the Test, you roll, the GM applies the effect." },
    { "name": "gravity", "label": "Gravity", "group": "describing", "value": { "type": "text", "max": 40 }, "acts": "describes", "stack": "top",
      "help": "Shown only." },
    { "name": "temperature", "label": "Temperature", "group": "describing", "value": { "type": "text", "max": 40 }, "acts": "describes", "stack": "top",
      "help": "Shown only." },
    { "name": "sound", "label": "Sound", "group": "describing", "value": { "type": "text", "max": 40 }, "acts": "describes", "stack": "top",
      "help": "Shown only." }
  ],
